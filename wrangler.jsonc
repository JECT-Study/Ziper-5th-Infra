{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ziper-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "durable_objects": {
    "bindings": [{ "name": "HOME_CIRCUIT", "class_name": "HomeCircuit" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HomeCircuit"] }],
  "vars": {
    "PUBLIC_ORIGIN": "https://api-ziper.joonamin.dev",
    "HOME_ORIGIN": "https://home-origin.invalid",
    "BACKUP_ORIGIN": "",
    "BACKUP_ENABLED": "false"
  }
}
