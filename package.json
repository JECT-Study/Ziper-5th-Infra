{
  "name": "ziper-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "types": "mkdir -p .wrangler/types && wrangler types --strict-vars false --include-runtime false && wrangler types .wrangler/types/runtime.d.ts --include-env false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.backup.config.ts",
    "test:deploy": "node --test scripts/deployment.test.ts && python3 scripts/test-home-receiver.py",
    "check": "npm run types && npm run typecheck && npm run lint && npm test && npm run test:deploy && npm run build",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.6.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "wrangler": "4.158.0"
  }
}
